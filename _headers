# Static assets: cache aggressively on Cloudflare Pages
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=31536000, immutable

/manifest.webmanifest
  Cache-Control: public, max-age=86400

# HTML: allow revalidation so deployments become visible quickly
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# Compression/security hints are normally handled by Cloudflare automatically.
